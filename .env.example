# ==========================================
# WuzMind Cognitive Service - Environment Configuration
# ==========================================
NODE_ENV=production
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/wuzmind
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wuzmind
DB_USER=postgres
DB_PASSWORD=postgres

# API Security Key
WUZMIND_API_KEY=your_secure_wuzmind_api_key_here

# AI Pipeline Configuration (Order: GEMINI -> OPENAI -> STATIC)
AI_PROVIDER_ORDER=GEMINI,OPENAI,STATIC
AI_TOTAL_TIMEOUT_MS=12000
AI_MAX_RETRIES_PER_PROVIDER=0
AI_MIN_CONFIDENCE=0.65

# Google Gemini (Primary AI Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=
GEMINI_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-1.5-flash,gemini-2.0-flash
GEMINI_MODELS_CACHE_TTL_MS=3600000
GEMINI_DISCOVERY_TIMEOUT_MS=5000
GEMINI_REQUEST_TIMEOUT_MS=6000
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI (Fallback AI Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_MS=5000
OPENAI_BASE_URL=https://api.openai.com/v1

# Logging
LOG_LEVEL=info
