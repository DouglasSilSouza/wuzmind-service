{
  "name": "wuzmind-service",
  "version": "0.1.0",
  "description": "Serviço cognitivo e desacoplado do ecossistema Wuzbot",
  "author": "Douglas Silva",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
